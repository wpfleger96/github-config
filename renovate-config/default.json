{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for wpfleger96 repos",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "platformAutomerge": true,
  "automergeType": "pr",
  "timezone": "America/New_York",
  "schedule": ["* * 1 * *"],
  "minimumReleaseAge": "1 week",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * 1 * *"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "corepack installed via npm in a Dockerfile",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["npm install -g (?<depName>corepack)@(?<currentValue>[0-9][^\\s]*)"],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": false,
      "groupName": "github-actions",
      "groupSlug": "github-actions"
    },
    {
      "matchDatasources": ["python-version", "node-version"],
      "automerge": false
    },
    {
      "matchDepNames": ["python", "node", "ruby", "golang", "openjdk", "eclipse-temurin"],
      "automerge": false
    }
  ]
}
