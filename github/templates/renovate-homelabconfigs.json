{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wpfleger96/github-config//renovate-config/default"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Grafana's VictoriaLogs datasource plugin, pinned in GF_PLUGINS_PREINSTALL_SYNC",
      "managerFilePatterns": ["/^ansible/playbooks/files/logs/docker-compose\\.yml$/"],
      "matchStrings": ["victoriametrics-logs-datasource@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "VictoriaMetrics/victorialogs-datasource",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Vector agent package, pinned from Vector's apt repository (it trails Vector's GitHub releases)",
      "managerFilePatterns": ["/^ansible/playbooks/tasks/vector_agent\\.yml$/"],
      "matchStrings": ["name: vector=(?<currentValue>\\S+)"],
      "depNameTemplate": "vector",
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb",
      "registryUrlTemplate": "https://apt.vector.dev?suite=stable&components=vector-0&binaryArch=amd64"
    }
  ],
  "packageRules": [
    {
      "description": "Own PR, never automerged: Home Assistant releases carry breaking changes.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant"],
      "automerge": false,
      "groupName": null
    },
    {
      "description": "The deb datasource reports no release dates, so the preset's minimumReleaseAge would hold the Vector agent pin forever.",
      "matchDatasources": ["deb"],
      "matchPackageNames": ["vector"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Never automerged: Vector is 0.x, and its minor releases break configs (0.61 made scheme-less vector sink endpoints https).",
      "matchPackageNames": ["vector", "timberio/vector"],
      "automerge": false
    }
  ]
}
